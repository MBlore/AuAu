package "main"

void main() {
    int a = 0
    while a < 10 {
        break
    }
    print(1)

    int b = 0
    while b < 10 {
        print(-1)
        b = b + 1
        continue
    }
    print(2)

    int c = 0
    while c < 10 {
        while c < 5 {
            break
        }
        break
    }
    print(3)
}